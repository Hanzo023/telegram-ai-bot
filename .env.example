TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================
# PRIMARY AI ENGINE: GOOGLE GEMINI (Required)
# ============================================================
# The bot runs natively and fully on Google Gemini.
# Get your free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Alternative/fallback key variable name supported:
# GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# OPTIONAL: HYBRID MODE (Anthropic Claude Sonnet 5.5)
# ============================================================
# If you wish to pair Claude Sonnet 5.5 for text/coding with Gemini for voice/search,
# set AI_PROVIDER=hybrid and configure your Anthropic credentials below:
# AI_PROVIDER=hybrid
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MAX_TOKENS=20000

# Support single or multiple comma-separated user IDs (e.g. 123456789,987654321)
ALLOWED_USER_ID=123456789,987654321
STORAGE_DIR="./"

# Optional: Netscape cookies.txt content or base64 string to bypass YouTube cloud datacenter bot checks on Render/AWS
YOUTUBE_COOKIES=

# Optional: Conversation session TTL in hours (default: 24) and max history messages kept per user (default: 50)
CONVERSATION_SESSION_TIMEOUT_HOURS=24
MAX_HISTORY_MESSAGES=50

# Optional: Remote Laptop Agent Bridge (for running terminal commands & editing files on your laptop via /agent)
# SERVER_URL=https://your-bot-name.onrender.com
# LAPTOP_RUNNER_SECRET=your_custom_secret_or_bot_token
# TELEGRAM_USER_ID=123456789
# DEVICE_NAME=My-Laptop
